SERVICE_NAME=compliant-outreach-orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

POSTGRES_DB=outreach_orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@postgres:5432/outreach_orchestrator
ALEMBIC_DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
