    {
      "id": "text_0011",
      "type": "text",
      "x": 1242,
      "y": 125,
      "width": 421,
      "height": 240,
      "strokeColor": "#1f2937",
      "text": "Call Worker\n1 - receive message (call_job_id)\n2 - Acquire distributed lock (call_job_id)\n3 - Check contact_attempts table (idempotency)\n4 - If no prior attempt -> dial and write the attempt to db\n5 - ACK the message and delete from queue",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle_0010",
      "originalText": "Call Worker\n1 - receive message (call_job_id)\n2 - Acquire distributed lock (call_job_id)\n3 - Check contact_attempts table (idempotency)\n4 - If no prior attempt -> dial and write the attempt to db\n5 - ACK the message and delete from queue",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 182.4,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
