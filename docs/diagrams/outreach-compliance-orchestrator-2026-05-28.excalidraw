    {
      "id": "text_0002",
      "type": "text",
      "x": 82.01953125,
      "y": -88.05338541666663,
      "width": 786,
      "height": 170,
      "strokeColor": "#1f2937",
      "text": "Functional Requirements\n- Ingest accounts/customers from financial institutions.\n- Select eligible customers using campaign and policy rules.\n- Contact customers through voice, SMS, and email.\n- Process provider callbacks, transcripts, recordings, and outcomes.\n- Run compliance review and preserve audit trail.\n- Expose dashboard and analytics for operators.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rectangle_0001",
      "originalText": "Functional Requirements\n- Ingest accounts/customers from financial institutions.\n- Select eligible customers using campaign and policy rules.\n- Contact customers through voice, SMS, and email.\n- Process provider callbacks, transcripts, recordings, and outcomes.\n- Run compliance review and preserve audit trail.\n- Expose dashboard and analytics for operators.",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 129.2,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 280528002,
      "version": 37,
