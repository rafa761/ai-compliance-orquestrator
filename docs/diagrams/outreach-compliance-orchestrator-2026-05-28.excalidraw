  "elements": [
    {
      "id": "AH0wlh3vWe1fYxM5fOGxt",
      "type": "text",
      "x": 389.5625,
      "y": -157.25,
      "width": 655.2393188476562,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 2004905811,
      "version": 515,
      "versionNonce": 31844959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780059663323,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Ingest accounts/customers from financial institutions.\n- Select eligible customers using campaign and policy rules.\n- Contact customers through voice, SMS, and email.\n- Process provider callbacks, transcripts, recordings, and outcomes.\n- Run compliance review and preserve audit trail.\n- Expose dashboard and analytics for operators.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- Ingest accounts/customers from financial institutions.\n- Select eligible customers using campaign and policy rules.\n- Contact customers through voice, SMS, and email.\n- Process provider callbacks, transcripts, recordings, and outcomes.\n- Run compliance review and preserve audit trail.\n- Expose dashboard and analytics for operators.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5JCCXZJHPVEDClRcMSKlt",
      "type": "text",
      "x": 1218.9331597222224,
      "y": -132.77126736111117,
      "width": 726.959228515625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1647192723,
      "version": 341,
      "versionNonce": 1650711729,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780059672768,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n- Idempotency for outreach and webhook processing.\n- Reliable async processing with retries, backoff, and DLQ.\n- Compliance controls: consent, opt-outs, contact windows, policy versions.\n- Scalable APIs/workers and OLAP analytics.\n- Low-latency voice path and fast webhook acknowledgement.\n- Tenant isolation, security, and observability.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n- Idempotency for outreach and webhook processing.\n- Reliable async processing with retries, backoff, and DLQ.\n- Compliance controls: consent, opt-outs, contact windows, policy versions.\n- Scalable APIs/workers and OLAP analytics.\n- Low-latency voice path and fast webhook acknowledgement.\n- Tenant isolation, security, and observability.",
      "autoResize": true,
      "lineHeight": 1.25
    },
